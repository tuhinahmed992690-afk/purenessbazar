
<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pureness Bazar | Super Admin</title>
  <style>
    *{box-sizing:border-box}
    body{margin:0;font-family:Arial,"Noto Sans Bengali",sans-serif;background:#f5f7fb;color:#243047}
    header{background:#176b43;color:white;padding:20px}
    header h1{margin:0;font-size:23px}
    header p{margin:7px 0 0}
    main{max-width:1100px;margin:24px auto;padding:0 15px}
    .card{background:white;padding:20px;border-radius:13px;margin-bottom:18px;box-shadow:0 3px 15px #0000000b}
    h2{font-size:19px;margin-top:0}
    input,select,button{font:inherit;padding:12px;border-radius:8px;border:1px solid #d5dce5;width:100%;margin:5px 0}
    button{background:#176b43;color:white;border:0;font-weight:bold;cursor:pointer}
    button.secondary{background:#e8f4ed;color:#176b43}
    button.danger{background:#a92f2f}
    .grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
    .stat{background:#f0f8f3;padding:16px;border-radius:10px}
    .stat strong{display:block;font-size:24px;margin-top:8px}
    .hidden{display:none!important}
    .muted{color:#687386;font-size:13px}
    .table-wrap{overflow-x:auto}
    table{border-collapse:collapse;width:100%;min-width:650px}
    th,td{text-align:left;padding:11px;border-bottom:1px solid #e9edf2;font-size:14px}
    th{background:#f4f7f5}
    .status{min-width:135px}
    #message{padding:10px;border-radius:8px;white-space:pre-wrap}
    @media(max-width:650px){
      .grid{grid-template-columns:1fr}
      header h1{font-size:20px}
      .card{padding:15px}
    }
  </style>
</head>
<body>
<header>
  <h1>🛍️ Pureness Bazar</h1>
  <p>Super Admin Panel — ব্যবসা পরিচালনা</p>
</header>

<main>
  <div id="message" class="hidden"></div>

  <section id="loginCard" class="card">
    <h2>🔐 অ্যাডমিন লগইন</h2>
    <p class="muted">শুধু অনুমোদিত অ্যাডমিন অ্যাকাউন্ট ব্যবহার করুন।</p>
    <form id="loginForm">
      <label for="email">অ্যাডমিন ইমেইল</label>
      <input id="email" type="email" autocomplete="username" required>
      <label for="password">পাসওয়ার্ড</label>
      <input id="password" type="password" autocomplete="current-password" required>
      <button type="submit">লগইন করুন</button>
    </form>
  </section>

  <section id="dashboard" class="hidden">
    <div class="card">
      <div style="display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap">
        <div>
          <h2>ড্যাশবোর্ড</h2>
          <div id="adminEmail" class="muted"></div>
        </div>
        <button id="logoutBtn" style="width:auto">লগআউট</button>
      </div>
    </div>

    <div class="grid">
      <div class="stat">মোট অর্ডার<strong id="orderCount">০</strong></div>
      <div class="stat">মোট বিক্রির পরিমাণ<strong id="salesTotal">৳০</strong></div>
      <div class="stat">নতুন অর্ডার<strong id="newCount">০</strong></div>
    </div>

    <div class="card" style="margin-top:18px">
      <h2>📦 অর্ডার ম্যানেজমেন্ট</h2>
      <button id="refreshBtn" class="secondary">অর্ডার রিফ্রেশ করুন</button>
      <button id="exportBtn" class="secondary">CSV রিপোর্ট ডাউনলোড</button>
      <div class="table-wrap" style="margin-top:12px">
        <table>
          <thead>
            <tr>
              <th>অর্ডার</th>
              <th>কাস্টমার</th>
              <th>মোবাইল</th>
              <th>মোট টাকা</th>
              <th>স্ট্যাটাস</th>
              <th>আপডেট</th>
            </tr>
          </thead>
          <tbody id="ordersBody">
            <tr><td colspan="6">অর্ডার লোড হচ্ছে...</td></tr>
          </tbody>
        </table>
      </div>
      <p class="muted">স্ট্যাটাস পরিবর্তন করতে তালিকা থেকে নির্বাচন করে “আপডেট” চাপুন।</p>
    </div>
  </section>
</main>

<script type="module">
  import { initializeApp } from
    "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
  import {
    getAuth, onAuthStateChanged, signInWithEmailAndPassword, signOut
  } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
  import {
    getFirestore, collection, getDocs, doc, updateDoc, query, orderBy
  } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

  // Pureness Bazar Firebase configuration
  const firebaseConfig = {
    apiKey: "AIzaSyCzeqngLF-vN_KkRKF_hhS4u8SkoMsWKz4",
    authDomain: "pureness-bazar.firebaseapp.com",
    projectId: "pureness-bazar",
    storageBucket: "pureness-bazar.firebasestorage.app",
    messagingSenderId: "228275568441",
    appId: "1:228275568441:web:445c4bf849b5bc0489b2e8",
    measurementId: "G-JJKLRWD7T8"
  };

  const ADMIN_UID = "OjiVWiY9tnaE3TJ8JmT8tnyyUVv2";

  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);
  const db = getFirestore(app);

  const $ = id => document.getElementById(id);
  let ordersCache = [];

  function showMessage(text, error = false) {
    const el = $("message");
    el.textContent = text;
    el.classList.remove("hidden");
    el.style.background = error ? "#ffeded" : "#e8f4ed";
    el.style.color = error ? "#9b2020" : "#176b43";
  }

  function hideMessage() {
    $("message").classList.add("hidden");
  }

  function money(value) {
    return "৳" + Number(value || 0).toLocaleString("bn-BD");
  }

  function safeText(value) {
    return String(value ?? "");
  }

  $("loginForm").addEventListener("submit", async event => {
    event.preventDefault();
    hideMessage();
    try {
      await signInWithEmailAndPassword(
        auth, $("email").value.trim(), $("password").value
      );
    } catch (error) {
      showMessage("লগইন হয়নি। ইমেইল, পাসওয়ার্ড ও Firebase Authentication সেটিংস পরীক্ষা করুন।", true);
      console.error(error);
    }
  });

  $("logoutBtn").addEventListener("click", async () => {
    await signOut(auth);
  });

  onAuthStateChanged(auth, async user => {
    if (!user) {
      $("loginCard").classList.remove("hidden");
      $("dashboard").classList.add("hidden");
      return;
    }

    if (user.uid !== ADMIN_UID) {
      await signOut(auth);
      showMessage("এই অ্যাকাউন্টটি অনুমোদিত Super Admin নয়।", true);
      return;
    }

    $("loginCard").classList.add("hidden");
    $("dashboard").classList.remove("hidden");
    $("adminEmail").textContent = "লগইন: " + (user.email || "");
    await loadOrders();
  });

  async function loadOrders() {
    hideMessage();
    $("ordersBody").innerHTML =
      '<tr><td colspan="6">অর্ডার লোড হচ্ছে...</td></tr>';

    try {
      const result = await getDocs(
        query(collection(db, "orders"), orderBy("createdAt", "desc"))
      );

      ordersCache = result.docs.map(item => ({
        id: item.id,
        ...item.data()
      }));

      $("orderCount").textContent =
        ordersCache.length.toLocaleString("bn-BD");

      const total = ordersCache.reduce(
        (sum, order) => sum + Number(order.total || 0), 0
      );
      $("salesTotal").textContent = money(total);

      $("newCount").textContent = ordersCache.filter(order =>
        ["new", "pending", "নতুন", "অপেক্ষমাণ"].includes(
          String(order.status || "").toLowerCase()
        )
      ).length.toLocaleString("bn-BD");

      renderOrders();
    } catch (error) {
      $("ordersBody").innerHTML =
        '<tr><td colspan="6">অর্ডার লোড হয়নি। Firestore Rules ও সংযোগ পরীক্ষা করুন।</td></tr>';
      showMessage("অর্ডার লোড করা যায়নি। Firebase Console-এর Firestore Rules পরীক্ষা করুন।", true);
      console.error(error);
    }
  }

  function renderOrders() {
    const body = $("ordersBody");
    body.replaceChildren();

    if (!ordersCache.length) {
      body.innerHTML = '<tr><td colspan="6">এখনো কোনো অর্ডার পাওয়া যায়নি।</td></tr>';
      return;
    }

    for (const order of ordersCache) {
      const tr = document.createElement("tr");

      const addCell = value => {
        const td = document.createElement("td");
        td.textContent = safeText(value);
        tr.appendChild(td);
        return td;
      };

      addCell(order.orderId || order.id);
      addCell(order.name || "নাম নেই");
      addCell(order.phone || "—");
      addCell(money(order.total));

      const statusCell = addCell("");
      const select = document.createElement("select");
      select.className = "status";

      for (const status of [
        ["new", "নতুন"],
        ["confirmed", "নিশ্চিত"],
        ["processing", "প্রস্তুত হচ্ছে"],
        ["shipped", "কুরিয়ারে পাঠানো"],
        ["delivered", "ডেলিভারি সম্পন্ন"],
        ["cancelled", "বাতিল"]
      ]) {
        const option = document.createElement("option");
        option.value = status[0];
        option.textContent = status[1];
        if (String(order.status || "new") === status[0]) {
          option.selected = true;
        }
        select.appendChild(option);
      }
      statusCell.appendChild(select);

      const actionCell = addCell("");
      const button = document.createElement("button");
      button.textContent = "আপডেট";
      button.style.minWidth = "85px";

      button.addEventListener("click", async () => {
        if (auth.currentUser?.uid !== ADMIN_UID) {
          showMessage("অ্যাডমিন অনুমতি পাওয়া যায়নি।", true);
          return;
        }
        button.disabled = true;
        try {
          await updateDoc(doc(db, "orders", order.id), {
            status: select.value
          });
          order.status = select.value;
          showMessage("অর্ডারের স্ট্যাটাস আপডেট হয়েছে।");
          await loadOrders();
        } catch (error) {
          showMessage("আপডেট হয়নি। Firestore Rules পরীক্ষা করুন।", true);
          console.error(error);
        } finally {
          button.disabled = false;
        }
      });

      actionCell.appendChild(button);
      body.appendChild(tr);
    }
  }

  $("refreshBtn").addEventListener("click", loadOrders);

  $("exportBtn").addEventListener("click", () => {
    const header = ["Order ID", "Customer", "Phone", "Address", "Total", "Status"];
    const rows = ordersCache.map(order => [
      order.orderId || order.id,
      order.name || "",
      order.phone || "",
      order.address || "",
      order.total || 0,
      order.status || ""
    ]);

    const csvCell = value =>
      '"' + String(value ?? "").replace(/"/g, '""') + '"';

    const csv = "\uFEFF" +
      [header, ...rows].map(row => row.map(csvCell).join(",")).join("\r\n");

    const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "pureness-bazar-orders.csv";
    a.click();
    URL.revokeObjectURL(url);
  });
</script>
</body>
</html>
